body{
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    
}

.header {
    text-align: center;
    font-family: "Baloo 2", sans-serif;
    color: #92C9B1;
    border: 3px solid #92C9B1;
    width: fit-content;
    height: fit-content;
    padding: 3px;
    margin-top: 30px;
}

.main-container{
    margin-top: 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    border: 1px solid #ccc;
    width: 360px;
    height: 370px;
}

.main-container h2 {
    margin-top: 15px;
    color: #92C9B1;
    font-family: "Baloo 2", sans-serif;
    text-align: center;
}

.main-container input {
    margin-top: 10px;
    border: none;
    border-bottom: 1px solid #92C9B1;
    height: 35px;
    width: 250px;
    padding: 6px;
    color: #92C9B1;
    
}

.main-container input::placeholder {
    color: #92C9B1;
}

.main-container input:focus {
    outline: none;
    box-shadow: none;
}

button {
    margin-top: 15px;
    width: 250px;
    height: 30px;
    font: bold;
    color: #fff;
    font-family: "Baloo 2", sans-serif;
    background-color: #92C9B1;
    border: 1px solid #92C9B1;
    border-radius: 5px;
    font-size: 14px;
}

.main-container hr {
    width: 250px;
    margin-top: 20px;
    background-color: #92C9B1;
    height: 0.5px;
}


.main-container p {
    margin-top: 10px;
    color: #92C9B1;
    font-family: "Baloo 2", sans-serif;
}

.main-container a {
    text-decoration: none;
    color: #92C9B1;
    font-family: "Baloo 2", sans-serif;

}



.container2 hr {
    width: 360pxpx;
    margin-top: 20px;
    background-color: #92C9B1;
    height: 0.5px;
}

.container2  {
    color: #92C9B1;
    text-align: center;
    font-family: "Baloo 2", sans-serif;
}

.container2 a {
    text-decoration: none;
    color: #92C9B1;
    font-family: "Baloo 2", sans-serif;

}
.container2 a:hover{
    border-bottom: 1px solid #92C9B1;
}

.main-container a:hover{
    border-bottom: 1px solid #92C9B1;
}
